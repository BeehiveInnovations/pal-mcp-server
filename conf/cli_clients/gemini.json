{
  "name": "gemini",
  "command": "gemini",
  "additional_args": [
    "--yolo",
    "--skip-trust",
    "-m",
    "gemini-3.8-flash"
  ],
  "env": {
    "GEMINI_CLI_TRUST_WORKSPACE": "true"
  },
  "roles": {
    "default": {
      "prompt_path": "systemprompts/clink/default.txt",
      "role_args": []
    },
    "planner": {
      "prompt_path": "systemprompts/clink/default_planner.txt",
      "role_args": []
    },
    "codereviewer": {
      "prompt_path": "systemprompts/clink/default_codereviewer.txt",
      "role_args": []
    }
  }
}
