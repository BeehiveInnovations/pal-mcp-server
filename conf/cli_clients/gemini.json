{
  "name": "gemini",
  "command": "gemini",
  "additional_args": [
    "--yolo",
    "-m",
    "gemini-2.5-flash"
  ],
  "env": {
    "GEMINI_API_KEY": "__REDACTED_SET_ENV_VAR__"
  },
  "roles": {
    "default": {
